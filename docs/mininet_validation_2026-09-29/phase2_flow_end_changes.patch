diff --git a/modules/external_flow_end.py b/modules/external_flow_end.py
new file mode 100644
index 0000000..fa1b650
--- /dev/null
+++ b/modules/external_flow_end.py
@@ -0,0 +1,64 @@
+# -*- coding: utf-8 -*-
+"""
+external_flow_end.py - 由外部（watchdog）直接告知 flow 結束（驗證用）
+
+reactive controller 本來只能靠 idle_timeout 過期（FlowRemoved）得知 flow 結束，
+有數秒延遲；sim.py 則是 flow 一到期就立刻 depart。這個模組把兩層分開：
+  - 網路實際行為：不動。switch 上的規則照舊靠 idle_timeout 過期（已知缺陷，保留）。
+  - controller 邏輯狀態：watchdog 在 flow 理論到期的當下，把 "src_mac dst_mac"
+    一行寫進 FLOW_END_QUEUE，controller 輪詢讀取後立即從 active_flows 移除，
+    並比照 flow_removed_handler 觸發 on_flow_removed（cascade 風格）——
+    能耗計算與選路看到的 active flow 時間軸因此與 sim.py 一致。
+之後規則真的 idle 過期時，flow_removed_handler 查不到 entry 會直接略過，不會重複移除。
+
+已知限制：同一 pair 在舊規則過期前（idle_timeout 內）重開，封包直接命中舊規則、
+不會 packet-in，controller 看不到這條新 flow。
+
+這是「讓 Mininet 模仿 sim 的完美資訊」的驗證用機制，真實網路做不到，
+預設關閉（DTM.py 的 ENABLE_EXTERNAL_FLOW_END）。
+
+使用方式：
+    self.external_flow_end = ExternalFlowEnd(self)   # DTM.py __init__ 建立
+    self.external_flow_end.poll()                     # 監聽執行緒每 0.2 秒呼叫
+"""
+
+import os
+import time
+
+FLOW_END_QUEUE = "flow_end.queue"
+
+
+class ExternalFlowEnd:
+    def __init__(self, app, path=FLOW_END_QUEUE):
+        self.app = app
+        self.path = path
+        # 從目前檔尾開始讀，忽略啟動前殘留的舊內容
+        self._offset = os.path.getsize(path) if os.path.exists(path) else 0
+
+    def poll(self):
+        try:
+            with open(self.path, 'r') as f:
+                f.seek(self._offset)
+                data = f.read()
+        except FileNotFoundError:
+            return
+        if not data:
+            return
+        # 只處理完整的行，半行留到下一輪
+        end = data.rfind('\n') + 1
+        self._offset += len(data[:end].encode('utf-8'))
+        for line in data[:end].splitlines():
+            parts = line.split()
+            if len(parts) == 2:
+                self.end_flow(parts[0], parts[1])
+
+    def end_flow(self, src_mac, dst_mac):
+        entry = self.app.flow_registry.active_flows.get((src_mac, dst_mac))
+        if entry is None:
+            print(f"[FLOW_END_EXT] {time.time():.3f} {src_mac} -> {dst_mac} 不在 active_flows，略過")
+            return
+        removed_path = entry['path']
+        self.app.remove_active_flow(src_mac, dst_mac)
+        if self.app.routing_module.REROUTE_STYLE == 'cascade':
+            self.app.routing_module.on_flow_removed(src_mac, dst_mac, removed_path)
+        print(f"[FLOW_END_EXT] {time.time():.3f} {src_mac} -> {dst_mac} path={removed_path}")
