            "flags": {"SORT_MODE": "SPF", "ENABLE_WEIGHT_MAP": false, "LINK_WEIGHT": true}},
  "name_regex": "^G55L_s(?P<seed_rng>\\d+)_(?P<traffic_level>xxlow|xlow|low|mid|high)_(?P<variant>SGH|ESP)(?P<nsp>_NSP)?(?:_rs(?P<random_seed>\\d+))?$",
